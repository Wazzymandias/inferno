# Compose profiles enable optional services; the API always starts.
# "local" provisions the model through Docker Model Runner. It is the only profile.
# Leave empty for an external backend, then set INFERENCE_ENDPOINT below.
COMPOSE_PROFILES=local

# Small MLX checkpoint for verifying local inference; replace for your workload.
INFERENCE_MODEL=hf.co/mlx-community/Llama-3.2-1B-Instruct-4bit

# Image sources can be changed without editing the Dockerfile.
RUST_IMAGE=rust:1.98-bookworm
RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot

# All interfaces; host and container ports can be changed independently.
API_ADDRESS=0.0.0.0
# Service listener.
API_PORT=8000
# Port published by Docker on the host.
API_HOST_PORT=8080

# External mode: clear COMPOSE_PROFILES and set your provider's API base URL.
INFERENCE_ENDPOINT=http://model-runner.docker.internal/v1
INFERENCE_TIMEOUT_SECONDS=300
MAX_REQUEST_BYTES=1048576

# Bound draining on SIGTERM within the container runtime's default stop window.
SHUTDOWN_TIMEOUT_SECONDS=5
