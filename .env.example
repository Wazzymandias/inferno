# just deploy starts native vLLM Metal and the Compose web/API services.
# Add metrics to start SigNoz alongside them.
COMPOSE_PROFILES=

# Model shared by native inference, the gateway, and the web app.
# Hugging Face repository ID or local snapshot directory.
INFERENCE_MODEL=mlx-community/Llama-3.2-1B-Instruct-4bit
# Native vLLM listener; just deploy also derives Compose's backend URL from this port.
INFERENCE_PORT=8002
# Bound the development KV cache to 1024 native blocks; vLLM fits its context
# length to that capacity. Change these native options for your memory budget.
# Use shell quoting for values containing spaces.
VLLM_ARGS=--num-gpu-blocks-override 1024 --max-model-len auto
# The launcher enables prefix caching, sha256_cbor, and full-byte event hashes
# (VLLM_KV_EVENTS_USE_INT_BLOCK_HASHES=0).
# Empty KV endpoints use tcp://*:0: vLLM binds independent OS-assigned ports.
# Override with complete native ZMQ endpoints for your deployment topology.
INFERENCE_KV_EVENTS_ENDPOINT=
INFERENCE_KV_EVENTS_REPLAY_ENDPOINT=
# Empty uses kv-events.
INFERENCE_KV_EVENTS_TOPIC=
# Optional native node address for OS-assigned KV endpoints; empty auto-detects.
VLLM_HOST_IP=

# Image sources can be changed without editing the Dockerfile.
RUST_IMAGE=rust:1.98-bookworm
RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot

# All interfaces; host and container ports can be changed independently.
API_ADDRESS=0.0.0.0
# Service listener.
API_PORT=8000
# Port published by Docker on the host.
API_HOST_PORT=8080

# Compose connects to the native server on the host. Override for another vLLM server.
# For multiple replicas, use a comma-separated list of complete API URLs.
INFERENCE_ENDPOINT=http://host.docker.internal:${INFERENCE_PORT}/v1
# Optional backend bearer token, used at startup and when no request token is supplied.
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_SECONDS=300
# Cached-token cost of each active request, including streaming. Must be positive.
ROUTING_LOAD_PENALTY=256
MAX_REQUEST_BYTES=1048576

# Bound draining on SIGTERM within the container runtime's default stop window.
SHUTDOWN_TIMEOUT_SECONDS=5

# React chat starts with just deploy.
# Empty uses the Compose gateway service and its configured API_PORT.
WEB_INFERENCE_ENDPOINT=
# Optional bearer token for the web server's inference requests; never public.
WEB_INFERENCE_API_KEY=
# Chat generation: 0 uses greedy decoding (the most likely next token).
INFERENCE_TEMPERATURE=0
# Maximum generated tokens per reply, including reasoning; a configurable budget.
INFERENCE_MAX_OUTPUT_TOKENS=512
# Listener/published port and host binding for the web service.
WEB_PORT=3000
WEB_HOST_PORT=3000
WEB_HOST_ADDR=0.0.0.0
BUN_IMAGE=oven/bun:1.4.2

# Optional SigNoz settings; add metrics to COMPOSE_PROFILES to start the stack.
# Empty generates a random database password retained in a Docker volume.
# To supply your own, use URL-safe characters and keep it across restarts.
SIGNOZ_POSTGRES_PASSWORD=
# Backing-service URLs; empty PostgreSQL DSN uses the stored database password.
SIGNOZ_POSTGRES_DSN=
SIGNOZ_CLICKHOUSE_DSN=tcp://signoz-clickhouse:9000
# Published UI and OTLP ports; databases stay on the Compose network.
SIGNOZ_HOST=127.0.0.1
SIGNOZ_UI_PORT=8081
SIGNOZ_OTLP_GRPC_PORT=4317
SIGNOZ_OTLP_HTTP_PORT=4318
# Image dependencies are locked by digest; override together for a tested upgrade.
SIGNOZ_IMAGE=signoz/signoz:v0.145.0@sha256:1301f2df51f01ba4227dfd5a8281e61d10aa09b771d2b20a30027bc68dba993d
SIGNOZ_COLLECTOR_IMAGE=signoz/signoz-otel-collector:v0.144.12@sha256:deb566a7a3c0ba544ee58ccc92ee1f0e6da827bc40383e52f3c824705e100a3d
SIGNOZ_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.12.5@sha256:cacf32d6884291dc2ff5e0156a97f46fc53ff7c929a7906d114e268a929dfd3a
SIGNOZ_KEEPER_IMAGE=clickhouse/clickhouse-keeper:25.12.5@sha256:525b8b0f93ccb371131c46f22a066ea43d33d74aba314203e8044609945d8524
SIGNOZ_POSTGRES_IMAGE=postgres:16-bookworm@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4
