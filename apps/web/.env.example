# Required API base URL, including its prefix. No endpoint is assumed by the app.
INFERENCE_ENDPOINT=
# Optional initial model; otherwise choose or enter an ID in the chat header.
INFERENCE_MODEL=
# Optional bearer token. Kept on the server; never included in browser assets.
INFERENCE_API_KEY=

# 0 uses greedy decoding (the most likely next token) to avoid random word salad.
INFERENCE_TEMPERATURE=0
# Maximum generated tokens per reply, including reasoning; a configurable budget.
INFERENCE_MAX_OUTPUT_TOKENS=512

WEB_HOST=0.0.0.0
WEB_PORT=3000
